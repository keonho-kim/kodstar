{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "rootDir": ".",
        "outDir": "dist",
        "sourceMap": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitOverride": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
